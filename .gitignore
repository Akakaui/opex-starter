# OPEX Starter Kit

# Backups
/tmp/opex-backup-*
/tmp/opex-backups/
*.bak

# Archives
*.tar.gz
*.zip

# Node
node_modules/
package-lock.json

# OS & editor
.DS_Store
Thumbs.db
